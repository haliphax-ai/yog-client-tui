{
  "name": "yog-client-tui",
  "version": "0.1.0",
  "description": "Terminal chat client for the yog agent harness daemon",
  "license": "MIT",
  "author": "haliphax <haliphax@gmail.com>",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "depcruise": "dependency-cruiser src test --config .dependency-cruiser.cjs",
    "depcruise:graph": "dependency-cruiser src --output-type mermaid",
    "commitlint": "commitlint",
    "prepare": "husky || true",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@oakoliver/bubbles": "^1.2.2",
    "@oakoliver/bubbletea": "^1.2.0",
    "@oakoliver/glamour": "^2.0.0",
    "@oakoliver/lipgloss": "^1.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "nano-staged": {
    "**/*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
